FROM python:3.13-slim-trixie

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/home/momoi

ARG NAP_MSG_COMMIT=f0e789d0134375faf5e56de2673139f685a0c7cf
ARG CHROME_DEVTOOLS_MCP_VERSION=1.6.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates chromium ffmpeg nodejs npm tzdata \
    && mkdir -p /opt/google/chrome \
    && ln -s /usr/bin/chromium /opt/google/chrome/chrome \
    && npm install --global "chrome-devtools-mcp@${CHROME_DEVTOOLS_MCP_VERSION}" \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir . \
        "nap-msg @ https://github.com/RicterZ/Openclaw-NapcatQQ/archive/${NAP_MSG_COMMIT}.zip#subdirectory=nap-msg"

EXPOSE 8787
ENTRYPOINT ["momoi"]
CMD ["run"]
