  "heartbeat": {
    "label": "心跳",
    "fields": {
      "enabled": {
        "type": "boolean",
        "label": "启用心跳",
        "default": true,
        "advanced": false
      }
    }
  },
  "logging": {
    "label": "日志",
    "fields": {
      "level": {
        "type": "string",
        "label": "日志级别",
        "default": "DEBUG",
        "enum": [
          "TRACE",
          "DEBUG",
          "INFO",
          "WARNING",
          "ERROR",
          "CRITICAL"
        ],
        "advanced": false
      }
    }
  },
  "reflection": {
    "label": "复盘",
    "fields": {
      "enabled": {
        "type": "boolean",
        "label": "启用复盘",
        "default": false,
        "advanced": false
      },
      "at": {
        "type": "string",
        "label": "复盘时间",
        "default": "03:00",
        "format": "time",
        "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
        "description": "每天执行复盘的时间（HH:MM），使用应用配置的时区。",
        "advanced": false
      }
    }
  },
  "episode_annealing": {
    "label": "话题维护",
    "fields": {
      "enabled": {
        "type": "boolean",
        "label": "启用 Episode 退火",
        "default": true,
        "advanced": false
      },
      "relations_enabled": {
        "type": "boolean",
        "label": "启用话题关联",
        "default": true,
        "advanced": false
      }
    }
  },
  "budget": {
    "label": "费用预算",
    "fields": {
      "enabled": {
        "type": "boolean",
        "label": "启用费用预算",
        "default": false,
        "advanced": false
      },
      "period": {
        "type": "string",
        "label": "预算周期",
        "enum": [
          "daily",
          "monthly"
        ],
        "default": "daily",
        "advanced": false
      },
      "amount": {
        "type": "number",
        "label": "预算上限（元）",
        "minimum": 0,
        "default": 0,
        "description": "按本地模型费用估算；达到上限暂停运行，新周期自动恢复。需启用账户余额中的费用估算。",
        "advanced": false
      }
    }
  }
