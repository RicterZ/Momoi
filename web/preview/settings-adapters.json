      },
      "base_url": {
        "type": "string",
        "default": "https://api.deepseek.com",
        "label": "服务地址",
        "advanced": false
      },
      "timeout_seconds": {
        "type": "number",
        "default": 10,
        "label": "请求超时（秒）",
