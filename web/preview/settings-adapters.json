      },
      "accounting": {
        "type": "boolean",
        "default": true,
        "label": "费用估算",
        "advanced": false,
        "description": "按 DeepSeek 用量和官方价格估算模型费用；模型使用其他服务商时请关闭。关闭后仍可查询余额并记录通用 Token 用量。"
      }
    },
    "test_supported": false
  },
